{
  "name": "naranijiizaya",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-27",
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [{ "binding": "CONTENT_DB", "database_name": "naranijiizaya-content" }],
  "routes": [
    { "pattern": "naranijiizaya.org", "custom_domain": true },
    { "pattern": "www.naranijiizaya.org", "custom_domain": true }
  ]
}
